{
  "editor.cursorBlinking": "expand",
  "editor.linkedEditing": true,
  "editor.guides.bracketPairs": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorWidth": 3,
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.removeUnusedImports": "explicit"
  },
  // ===== CONFIGURACIÓN DE PRETTIER =====
  "prettier.singleQuote": true,
  "prettier.trailingComma": "all",
  "prettier.printWidth": 120,
  "prettier.tabWidth": 2,
  "prettier.useTabs": false,
  "prettier.semi": true,
  "prettier.arrowParens": "always",
  "prettier.bracketSpacing": true,
  "prettier.endOfLine": "lf",
  "prettier.jsxSingleQuote": true,
  "prettier.proseWrap": "preserve",
  // ===== CONFIGURACIÓN GENERAL DE LENGUAJES =====
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.preferences.importModuleSpecifier": "shortest",
  "js/ts.suggest.autoImports": true,
  // ===== CONFIGURACIÓN JSON =====
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  // ===== CONFIGURACIÓN JSONC (JSON con comentarios) =====
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  // ===== CONFIGURACIÓN JAVASCRIPT =====
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  // ===== CONFIGURACIÓN TYPESCRIPT =====
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  // ===== CONFIGURACIÓN REACT (JSX/TSX) =====
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  // ===== CONFIGURACIÓN VUE =====
  "[vue]": {
    "editor.defaultFormatter": "Vue.volar",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  // === VOLAR (Vue Language Features) - Recomendado para Vue 3 ===
  // Editor Settings
  "vue.editor.focusMode": false,
  "vue.editor.reactivityVisualization": true,
  "vue.editor.templateInterpolationDecorators": true,
  // Completion Settings
  "vue.suggest.componentNameCasing": "preferPascalCase",
  "vue.suggest.propNameCasing": "preferCamelCase",
  "vue.suggest.defineAssignment": true,
  // Auto-Insert Settings
  "vue.autoInsert.dotValue": true,
  "vue.autoInsert.bracketSpacing": true,
  // Inlay Hints Settings
  "vue.inlayHints.destructuredProps": false,
  "vue.inlayHints.inlineHandlerLeading": true,
  "vue.inlayHints.missingProps": true,
  "vue.inlayHints.optionsWrapper": false,
  "vue.inlayHints.vBindShorthand": false,
  // Formatting Settings
  "vue.format.script.enabled": true,
  "vue.format.template.enabled": true,
  "vue.format.style.enabled": true,
  "vue.format.wrapAttributes": "auto",
  // Server Settings
  // "vue.server.path": "", // Path personalizado al language server
  "vue.server.includeLanguages": ["vue"],
  "vue.trace.server": "off",
  // ===== CONFIGURACIÓN ASTRO =====
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  // ===== CONFIGURACIÓN SVELTE =====
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.suggest.insertMode": "replace"
  },
  // Svelte TypeScript Plugin - IntelliSense en archivos TS/JS
  "svelte.enable-ts-plugin": true,
  // Svelte Language Server - Configuración avanzada
  // "svelte.language-server.runtime": "node", // Path al ejecutable de Node (útil para módulos nativos)
  // "svelte.language-server.ls-path": "./node_modules/svelte-language-server/bin/server.js", // Path personalizado al LS
  // "svelte.language-server.runtime-args": [], // Argumentos adicionales para Node (ej: ["--loader", ".pnp.loader.mjs"])
  // "svelte.language-server.port": -1, // Puerto para debugging (-1 = default)
  // Debugging - Tracing de comunicación VS Code ↔ Language Server
  "svelte.trace.server": "off", // Opciones: "off", "messages", "verbose"
  // Plugin: Formato y validación de Svelte
  "svelte.plugin.svelte.format.enable": true,
  "svelte.plugin.svelte.format.indentScriptAndStyle": true,
  "svelte.plugin.svelte.format.wrapAttributes": "auto",
  "svelte.plugin.svelte.compilerWarnings": {
    "a11y-missing-attribute": "ignore",
    "a11y-missing-content": "ignore",
    "a11y-click-events-have-key-events": "ignore",
    "a11y-no-static-element-interactions": "ignore"
  },
  // Plugin: TypeScript en Svelte
  "svelte.plugin.typescript.enable": true,
  "svelte.plugin.typescript.diagnostics.enable": true,
  "svelte.plugin.typescript.hover.enable": true,
  "svelte.plugin.typescript.documentSymbols.enable": true,
  "svelte.plugin.typescript.codeActions.enable": true,
  "svelte.plugin.typescript.selectionRange.enable": true,
  "svelte.plugin.typescript.rename.enable": true,
  "svelte.plugin.typescript.signatureHelp.enable": true,
  "svelte.plugin.typescript.inlayHints.enable": true,
  // Plugin: CSS/SCSS/Less en Svelte
  "svelte.plugin.css.enable": true,
  "svelte.plugin.css.diagnostics.enable": true,
  "svelte.plugin.css.hover.enable": true,
  "svelte.plugin.css.completions.enable": true,
  "svelte.plugin.css.codeActions.enable": true,
  "svelte.plugin.css.documentColors.enable": true,
  "svelte.plugin.css.colorPresentations.enable": true,
  "svelte.plugin.css.documentSymbols.enable": true,
  "svelte.plugin.css.selectionRange.enable": true,
  // Plugin: HTML en Svelte
  "svelte.plugin.html.enable": true,
  "svelte.plugin.html.hover.enable": true,
  "svelte.plugin.html.completions.enable": true,
  "svelte.plugin.html.tagComplete.enable": true,
  "svelte.plugin.html.documentSymbols.enable": true,
  "svelte.plugin.html.linkedEditing.enable": true,
  // ===== CONFIGURACIÓN HTML =====
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.linkedEditing": true
  },
  "html.format.wrapLineLength": 120,
  "html.format.indentInnerHtml": true,
  "html.format.wrapAttributes": "auto",
  "html.format.endWithNewline": true,
  "html.suggest.html5": true,
  "html.autoCreateQuotes": true,
  // ===== CONFIGURACIÓN CSS =====
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[less]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "css.validate": true,
  "css.lint.unknownAtRules": "ignore",
  "scss.validate": true,
  "less.validate": true,
  // ===== CONFIGURACIÓN TAILWIND CSS =====
  // Quick Suggestions - Activar completions en strings (JSX attributes, etc.)
  "editor.quickSuggestions": {
    "strings": "on"
  },
  // Core Settings - Lenguajes soportados
  "tailwindCSS.includeLanguages": {
    "vue": "html",
    "svelte": "html",
    "astro": "html",
    "plaintext": "html"
  },
  // Files Exclude - Exclusiones de IntelliSense
  "tailwindCSS.files.exclude": ["**/.git/**", "**/node_modules/**", "**/.hg/**", "**/.svn/**"],
  // IntelliSense Settings
  "tailwindCSS.emmetCompletions": false,
  "tailwindCSS.classAttributes": ["class", "className", "ngClass", "class:list"],
  "tailwindCSS.classFunctions": ["tw", "clsx", "cn", "cva", "tw\\.[a-z-]+"],
  "tailwindCSS.colorDecorators": true,
  "tailwindCSS.showPixelEquivalents": true,
  "tailwindCSS.rootFontSize": 16,
  "tailwindCSS.hovers": true,
  "tailwindCSS.suggestions": true,
  "tailwindCSS.codeActions": true,
  // Linting Rules
  "tailwindCSS.validate": true,
  "tailwindCSS.lint.invalidScreen": "error",
  "tailwindCSS.lint.invalidVariant": "error",
  "tailwindCSS.lint.invalidTailwindDirective": "error",
  "tailwindCSS.lint.invalidApply": "error",
  "tailwindCSS.lint.invalidConfigPath": "error",
  "tailwindCSS.lint.cssConflict": "warning",
  "tailwindCSS.lint.recommendedVariantOrder": "warning",
  "tailwindCSS.lint.usedBlocklistedClass": "warning",
  "tailwindCSS.lint.suggestCanonicalClasses": "warning",
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`\\]([^\"'`]*).*?[\"'`\\]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  // ===== CONFIGURACIÓN PYTHON =====
  "[python]": {
    "editor.defaultFormatter": "ms-python.python",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.unusedImports": "explicit"
    }
  },
  "python.languageServer": "Pylance",
  "python.analysis.languageServerMode": "full",
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.callArgumentNames": "partial",
  "python.analysis.fixAll": [
    "source.unusedImports",
    "source.convertImportFormat",
    "source.convertImportStar",
    "source.addTypeAnnotation"
  ],
  "python.analysis.aiCodeActions": {
    "implementAbstractClasses": true,
    "generateSymbol": true,
    "generateDocstring": true
  },
  "python.analysis.packageIndexDepths": [
    { "name": "sklearn", "depth": 2 },
    { "name": "matplotlib", "depth": 2 },
    { "name": "scipy", "depth": 2 },
    { "name": "django", "depth": 2 },
    { "name": "flask", "depth": 2 },
    { "name": "fastapi", "depth": 2 },
    { "name": "cuda", "depth": 3, "includeAllSymbols": true }
  ],
  "python.analysis.exclude": [
    "**/.*",
    "**/.venv",
    "**/.git",
    "**/.pytest_cache",
    "**/__pycache__",
    "**/node_modules",
    "CTkMessagebox"
  ],
  "python.analysis.diagnosticSeverityOverrides": { "reportAttributeAccessIssue": "none" },
  "editor.semanticTokenColorCustomizations": {
    "[One Dark Pro]": {
      "enabled": true,
      "rules": {
        "magicFunction:python": "#ee0000",
        "function.declaration:python": "#990000",
        "*.decorator:python": "#0000dd",
        "*.typeHint:python": "#5500aa",
        "*.typeHintComment:python": "#aaaaaa"
      }
    }
  },
  // ===== CONFIGURACIÓN JAVA =====
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "java.configuration.updateBuildConfiguration": "automatic"
  },
  // ===== CONFIGURACIÓN RUST =====
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  // ===== CONFIGURACIÓN GO =====
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false,
    "editor.tabSize": 4
  },
  // ===== CONFIGURACIÓN C# =====
  "[csharp]": {
    "editor.defaultFormatter": null,
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "omnisharp.enableRoslynAnalyzers": true,
  "omnisharp.enableEditorConfigSupport": true,
  "omnisharp.enableImportCompletion": true,
  "omnisharp.useModernNet": true,
  "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true,
  "dotnet.codeLens.enableReferencesCodeLens": true,
  "dotnet.inlayHints.enableInlayHintsForParameters": true,
  "dotnet.inlayHints.enableInlayHintsForTypes": true,
  "dotnet.inlayHints.enableInlayHintsForLiteralParameters": true,
  "dotnet.inlayHints.enableInlayHintsForIndexerParameters": true,
  "dotnet.inlayHints.enableInlayHintsForObjectCreationParameters": true,
  "dotnet.inlayHints.enableInlayHintsForOtherParameters": true,
  "dotnet.inlayHints.enableInlayHintsForImplicitVariableTypes": true,
  "dotnet.inlayHints.enableInlayHintsForLambdaParameterTypes": true,
  "dotnet.inlayHints.enableInlayHintsForImplicitObjectCreation": true,
  // ===== CONFIGURACIÓN RUBY =====
  "rubyLsp.rubyExecutablePath": "c:\\Ruby40-x64\\bin\\ruby.exe",
  "rubyLsp.indexing": {
    "excludedPatterns": ["**/node_modules/**", "**/.git/**", "**/tmp/**", "**/vendor/bundle/**"]
  },
  "rubyLsp.enabledFeatures": {
    "codeActions": true,
    "diagnostics": true,
    "documentHighlights": true,
    "documentLink": true,
    "documentSymbols": true,
    "foldingRanges": true,
    "formatting": true,
    "hover": true,
    "inlayHint": true,
    "onTypeFormatting": true,
    "selectionRanges": true,
    "semanticHighlighting": true,
    "codeLens": true,
    "definition": true,
    "workspaceSymbol": true,
    "signatureHelp": true,
    "typeHierarchy": true
  },
  "rubyLsp.formatter": "auto",
  "[ruby]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp",
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.rulers": [80, 120, 650],
    "editor.semanticHighlighting.enabled": true
  },
  "[erb]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  // ===== CONFIGURACIÓN YAML =====
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  // ===== CONFIGURACIÓN MARKDOWN =====
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 120,
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  // ===== CONFIGURACIÓN MJS =====
  "[mjs]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  // ===== CONFIGURACIÓN DE GIT =====
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "gitlens.advanced.messages": {
    "suppressCreatePullRequestPrompt": true
  },
  // ===== CONFIGURACIÓN DE BRACKETS Y SÍMBOLOS =====
  "editor.language.brackets": [],
  "editor.autoClosingBrackets": "always",
  "editor.autoClosingQuotes": "always",
  "editor.bracketPairColorization.enabled": true,
  // ===== CONFIGURACIÓN DE WORD WRAP =====
  "editor.wordWrap": "on",
  "editor.rulers": [120],
  // ===== CONFIGURACIÓN DE ARCHIVOS =====
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.associations": {
    "*.css": "tailwindcss",
    "*.scss": "scss",
    "*.less": "less",
    "*.mjs": "javascript",
    "*.yml": "yaml",
    "*.yaml": "yaml",
    "*.vue": "vue",
    "*.astro": "astro",
    "*.svelte": "svelte",
    "*.erb": "erb"
  },
  // ===== CONFIGURACIÓN DE ESLINT =====
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": ["."],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "astro",
    "svelte",
    "html"
  ],
  "git.ignoreLimitWarning": true
}
