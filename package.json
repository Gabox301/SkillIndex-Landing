{
  "name": "skillindex",
  "version": "3.0.5",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "bun run typecheck && bun run check && bun run lint && astro build",
    "typecheck": "tsc --noEmit",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint",
    "fmt": "oxfmt --write .",
    "fmt:staged": "oxfmt --write --no-error-on-unmatched-pattern",
    "fmt:check": "oxfmt --check .",
    "fendo:check": "bun scripts/fendo.ts"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.1",
    "geist": "1.7.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "puppeteer": "25.10.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.0"
}
