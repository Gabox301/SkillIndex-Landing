{
  "name": "skillindex",
  "version": "3.0.5",
  "type": "module",
  "scripts": {
    "dev": "bun run cli-version && bun run registry-manifest && astro dev",
    "cli-version": "bun scripts/cli-version.ts",
    "registry-manifest": "bun scripts/registry-manifest.ts",
    "build": "bun run cli-version && bun run registry-manifest && bun run typecheck && bun run check && bun run lint && astro build",
    "typecheck": "bun run cli-version && bun run registry-manifest && astro sync && tsc --noEmit",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint",
    "fmt": "oxfmt --write .",
    "fmt:staged": "oxfmt --write --no-error-on-unmatched-pattern",
    "fmt:check": "oxfmt --check .",
    "fendo:check": "bun scripts/fendo.ts"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@lucide/astro": "1.47.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.3",
    "geist": "1.7.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "puppeteer": "25.11.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.2"
}
