---

---

<div class='mb-12'>
  <p class='hud-label mb-6'><span class='hud-tag'>[ 02 ]</span> Opciones</p>
  <div class='flags'>
    <div class='flag'>
      <span class='flag-name'>-y, --yes</span>
      <span class='flag-desc'>Omitir confirmación</span>
    </div>
    <div class='flag'>
      <span class='flag-name'>--dry-run</span>
      <span class='flag-desc'>Mostrar skills sin instalar</span>
    </div>
    <div class='flag'>
      <span class='flag-name'>-v, --verbose</span>
      <span class='flag-desc'>Mostrar traza de instalación y detalles de errores</span>
    </div>
    <div class='flag'>
      <span class='flag-name'>-a, --agent</span>
      <span class='flag-desc'>Instalar solo para IDEs específicos (ej. cursor, claude-code, opencode)</span>
    </div>
    <div class='flag'>
      <span class='flag-name'>-d, --domain</span>
      <span class='flag-desc'>Instalar un set completo por id, combinado con lo detectado</span>
    </div>
    <div class='flag'>
      <span class='flag-name'>--clear-cache</span>
      <span class='flag-desc'>Limpiar la caché de skills descargadas</span>
    </div>
    <div class='flag'>
      <span class='flag-name'>-h, --help</span>
      <span class='flag-desc'>Mostrar ayuda</span>
    </div>
  </div>
</div>
