---
import HeroBanner from './HeroBanner.astro';

interface Props {
  cliVersion: string;
}
const { cliVersion } = Astro.props;
---

<p class='hud-meta mb-6'>ÚLTIMA VERSIÓN --- v{cliVersion}</p>

<h1 class='hero-title'>
  <HeroBanner />
  <span class='sr-only'>SkillIndex</span>
</h1>
<p class='hero-subtitle'>Reconocimiento autónomo de capacidades</p>

<p class='recon-desc mb-10'>
  Detecta automáticamente tu stack tecnológico e instala las mejores skills de agentes IA para tu proyecto.
</p>
