---
import HeroBanner from './HeroBanner.astro';

interface Props {
  cliVersion: string;
  totalSkills: number;
}
const { cliVersion, totalSkills } = Astro.props;
---

<p class='hud-meta mb-6'>ÚLTIMA VERSIÓN --- v{cliVersion}</p>

<h1 class='hero-title'>
  <HeroBanner />
  <span class='sr-only'>SkillIndex</span>
</h1>
<p class='hero-subtitle'>Reconocimiento autónomo de skills</p>

<p class='recon-desc mb-4'>Un comando detecta tu stack e instala en tu agente las skills exactas de tu proyecto.</p>

<p class='hud-meta mb-10'>ACTUALMENTE {totalSkills.toLocaleString('en-US')} SKILLS CURADAS EN EL REGISTRO</p>
