---
import { Check, Copy } from '@lucide/astro';
---

<div class='mb-12'>
  <p class='hud-label mb-3'>Instalación</p>
  <!-- Tab selector -->
  <div class='install-tabs' role='tablist' aria-label='Método de instalación'>
    <button class='install-tab install-tab--active' role='tab' aria-selected='true' data-tab='npm'>npm</button>
    <button class='install-tab' role='tab' aria-selected='false' data-tab='pnpm'>pnpm</button>
    <button class='install-tab' role='tab' aria-selected='false' data-tab='yarn'>yarn</button>
    <button class='install-tab' role='tab' aria-selected='false' data-tab='bun'>bun</button>
    <button class='install-tab' role='tab' aria-selected='false' data-tab='cargo'>cargo</button>
  </div>
  <!-- npm panel -->
  <div class='install-panel' id='panel-npm' role='tabpanel'>
    <button class='hero-cta' data-copy='npx skillindex' aria-label='Copiar comando npx skillindex'>
      <span class='hero-cta-prompt'>$</span>
      <span class='hero-cta-cmd'>npx skillindex</span>
      <span class='hero-cta-copy-icon'><Copy /><Check /></span>
    </button>
    <p class='install-alt'>
      O instala globalmente: <code class='install-code'>npm i -g skillindex</code>
    </p>
  </div>
  <!-- pnpm panel -->
  <div class='install-panel install-panel--hidden' id='panel-pnpm' role='tabpanel'>
    <button class='hero-cta' data-copy='pnpm dlx skillindex' aria-label='Copiar comando pnpm dlx skillindex'>
      <span class='hero-cta-prompt'>$</span>
      <span class='hero-cta-cmd'>pnpm dlx skillindex</span>
      <span class='hero-cta-copy-icon'><Copy /><Check /></span>
    </button>
    <p class='install-alt'>
      O instala globalmente: <code class='install-code'>pnpm add -g skillindex</code>
    </p>
  </div>
  <!-- yarn panel -->
  <div class='install-panel install-panel--hidden' id='panel-yarn' role='tabpanel'>
    <button class='hero-cta' data-copy='yarn dlx skillindex' aria-label='Copiar comando yarn dlx skillindex'>
      <span class='hero-cta-prompt'>$</span>
      <span class='hero-cta-cmd'>yarn dlx skillindex</span>
      <span class='hero-cta-copy-icon'><Copy /><Check /></span>
    </button>
    <p class='install-alt'>
      O instala globalmente: <code class='install-code'>yarn global add skillindex</code>
    </p>
  </div>
  <!-- bun panel -->
  <div class='install-panel install-panel--hidden' id='panel-bun' role='tabpanel'>
    <button class='hero-cta' data-copy='bunx skillindex' aria-label='Copiar comando bunx skillindex'>
      <span class='hero-cta-prompt'>$</span>
      <span class='hero-cta-cmd'>bunx skillindex</span>
      <span class='hero-cta-copy-icon'><Copy /><Check /></span>
    </button>
    <p class='install-alt'>
      O instala globalmente: <code class='install-code'>bun add -g skillindex</code>
    </p>
  </div>
  <!-- cargo panel -->
  <div class='install-panel install-panel--hidden' id='panel-cargo' role='tabpanel'>
    <button class='hero-cta' data-copy='cargo install skillindex' aria-label='Copiar comando cargo install skillindex'>
      <span class='hero-cta-prompt'>$</span>
      <span class='hero-cta-cmd'>cargo install skillindex</span>
      <span class='hero-cta-copy-icon'><Copy /><Check /></span>
    </button>
    <p class='install-alt'>
      Luego ejecuta: <code class='install-code'>skillindex</code> en tu proyecto
    </p>
  </div>
  <!-- Copied feedback (shared) -->
  <p class='install-copied' id='install-copied' aria-live='polite'></p>
</div>

<style>
  .install-tabs {
    display: flex;
    gap: 0;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid rgba(63, 63, 70, 0.5);
  }
  .install-tab {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #52525b;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0.35rem 0.85rem 0.45rem;
    cursor: pointer;
    margin-bottom: -1px;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .install-tab:hover {
    color: #a1a1aa;
  }
  .install-tab--active {
    color: #2dd4bf;
    border-bottom-color: #2dd4bf;
  }

  .install-panel {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .install-panel--hidden {
    display: none;
  }

  .hero-cta-copy-icon {
    margin-left: auto;
    color: #3f3f46;
    transition: color 0.15s ease;
    position: relative;
    display: inline-flex;
  }
  .hero-cta-copy-icon svg {
    width: 0.8rem;
    height: 0.8rem;
  }
  /* Check overlays Copy: toggle via .is-copied, no layout shift */
  .hero-cta-copy-icon svg:last-child {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }
  .hero-cta-copy-icon.is-copied svg:first-child {
    visibility: hidden;
  }
  .hero-cta-copy-icon.is-copied svg:last-child {
    visibility: visible;
  }
  .hero-cta:hover .hero-cta-copy-icon {
    color: #2dd4bf;
  }

  .install-alt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #52525b;
    margin: 0;
  }
  .install-code {
    color: #a1a1aa;
    font-family: var(--font-mono);
  }

  .install-copied {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: #2dd4bf;
    letter-spacing: 0.1em;
    min-height: 1rem;
    margin: 0;
  }
</style>
