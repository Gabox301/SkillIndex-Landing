---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import cliMeta from '../generated/cli-version.json';
import HeroHeader from '../components/HeroHeader.astro';
import InstallCommand from '../components/InstallCommand.astro';
import TerminalPanel from '../components/TerminalPanel.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CliOptions from '../components/CliOptions.astro';
import TechList from '../components/TechList.astro';
import { CATEGORIES, TECH_CATEGORY, DOMAINS } from '../tech-categories';
import DomainSets from '../components/DomainSets.astro';
import registryMeta from '../generated/registry.json';
import PageFooter from '../components/PageFooter.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const iconFiles = import.meta.glob<string>('../assets/icons/*.svg', { query: '?url', import: 'default', eager: true });

function toFilename(name: string) {
  return name.toLowerCase().replace(/#/g, 'sharp').replace(/\//g, '-').replace(/\s+/g, '-').replace(/\./g, '') + '.svg';
}

function getIconUrl(name: string): string | undefined {
  return iconFiles[`../assets/icons/${toFilename(name)}`];
}

const skillsEntries = await getCollection('skills');
const SKILLS_MAP = skillsEntries.map((e: CollectionEntry<'skills'>) => ({ id: e.id, ...e.data }));
const HIDDEN_TECH_IDS = new Set(['cloudflare-agents', 'cloudflare-durable-objects', 'cloudflare-ai']);
const visibleSkills = SKILLS_MAP.filter((t: any) => !HIDDEN_TECH_IDS.has(t.id));
const cliVersion = cliMeta.version;
const buildStamp = new Date().toISOString().slice(0, 7).replace('-', '.');
const popularityOrder = [
  'typescript',
  'zod',
  'react-hook-form',
  'react',
  'nextjs',
  'node',
  'tailwind',
  'vue',
  'angular',
  'vite',
  'astro',
  'nuxt',
  'svelte',
  'expo',
  'react-native',
  'bun',
  'elysia',
  'deno',
  'supabase',
  'cloudflare',
  'terraform',
  'vercel-deploy',
  'vercel-ai',
  'shadcn',
  'playwright',
  'turborepo',
  'better-auth',
  'clerk',
  'pinia',
  'neon',
  'remotion',
  'gsap',
  'oxlint',
  'express',
  'go',
  'swiftui',
  'azure',
  'aws',
  'elevenlabs',
  'kotlin-multiplatform',
  'android',
  'java',
  'springboot',
  'threejs',
];
const skillsMap = [...visibleSkills].sort((a: any, b: any) => {
  const ai = popularityOrder.indexOf(a.id);
  const bi = popularityOrder.indexOf(b.id);
  return (ai === -1 ? Infinity : ai) - (bi === -1 ? Infinity : bi);
});

interface TechSection {
  id: string;
  title: string;
  description: string;
  techs: typeof skillsMap;
}

const sections: TechSection[] = CATEGORIES.map((cat) => ({
  ...cat,
  techs: skillsMap.filter((t: any) => (TECH_CATEGORY[t.id] ?? 'otras') === cat.id),
})).filter((s) => s.techs.length > 0);

const unmappedIds = skillsMap.filter((t: any) => !(t.id in TECH_CATEGORY)).map((t: any) => t.id);

if (unmappedIds.length > 0) console.warn(`[tech-categories] unmapped ids: ${[...new Set(unmappedIds)].join(', ')}`);
---

<Layout>
  <div class='recon-root'>
    <div class='recon-grid' aria-hidden='true'></div>
    <div class='recon-vignette' aria-hidden='true'></div>
    <span class='corner corner-tl' aria-hidden='true'></span>
    <span class='corner corner-tr' aria-hidden='true'></span>
    <span class='corner corner-bl' aria-hidden='true'></span>
    <span class='corner corner-br' aria-hidden='true'></span>
    <main class='recon-left text-sm leading-relaxed px-6 pt-20 pb-12 lg:w-1/2 lg:pl-12 lg:pr-8 lg:pt-20 lg:pb-16'>
      <HeroHeader cliVersion={cliVersion} totalSkills={registryMeta.totalSkills} />
      <InstallCommand />
      <TerminalPanel cliVersion={cliVersion} />
      <div class='mb-12 hud-sep'></div>
      <HowItWorks />
      <div class='mb-12 hud-sep'></div>
      <CliOptions />
      <div class='mb-12 hud-sep'></div>
      <TechList sections={sections} getIconUrl={getIconUrl} />
      <div class='mb-12 hud-sep'></div>
      <DomainSets domains={DOMAINS} />
      <div class='mb-12 hud-sep'></div>
      <PageFooter buildStamp={buildStamp} />
    </main>
  </div>
  <script>
    import { initDomainCommands } from '../scripts/domain-commands';
    import { initInstallCommand } from '../scripts/install-command';
    import { initTerminal } from '../scripts/terminal';
    initInstallCommand();
    initTerminal();
    initDomainCommands();
  </script>
</Layout>
